[init]
	defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[user]
	name = Thiraphat
	email = thirphathrsricitr9@gmail.com
[credential]
	helper = store
	useHttpPath = true
[core]
	editor = code --wait
	autocrlf = input
[pull]
	rebase = true
[push]
	default = current
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	autoSquash = true
[rerere]
	enabled = true
[color]
	ui = auto
[branch]
	sort = -committerdate
[alias]
	st = status --short --branch
	co = checkout
	cb = checkout -b
	br = branch --sort=-committerdate
	ci = commit
	cm = commit -m
	amend = commit --amend
	last = log -1 HEAD --stat
	lg = log --oneline --decorate --graph --all -30
	uncommit = reset --soft HEAD~1
	unstage = reset HEAD --
	d = diff
	ds = diff --staged
	who = shortlog -sn
